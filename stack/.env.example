# Moonlight Oil settings.
#
# You normally never touch this. The installer creates a real `.env` next to
# this file on first run and fills in a random STORYTELLER_SECRET_KEY.
# This `.env.example` just documents what each setting means.

# --- Ports (change only if something else on the PC already uses them) ------
HOME_PORT=8080          # the home page Dad opens
STORYTELLER_PORT=8001   # Storyteller web app
READIUM_PORT=8002       # Storyteller's reader engine
FLOWSTATE_PORT=8003     # only used if you self-host FlowState

# --- Storyteller ------------------------------------------------------------
# Long random string that keeps logins secure. The installer generates one.
STORYTELLER_SECRET_KEY=replace-me-the-installer-does-this-automatically
STORYTELLER_LOG_LEVEL=info
PUID=1000
PGID=1000

# --- FlowState Reader -------------------------------------------------------
# Built from source (https://github.com/PeggyZWY/flowstate-webapp).
# Pin to a branch or commit for reproducible builds.
FLOWSTATE_REF=master
